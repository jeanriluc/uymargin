# Solo nombres y valores de ejemplo. Copiá este archivo a .env y completá los reales; .env no se sube a git.

# Servidor local
PORT=3001
# Por defecto el servidor escucha solo en 127.0.0.1; HOST=0.0.0.0 lo expone a la red.
# HOST=127.0.0.1

# Mercado Libre (radar y "Por enlace"): ML_CLIENT_ID + ML_CLIENT_SECRET, o bien ML_ACCESS_TOKEN.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# ML_ACCESS_TOKEN=

# Copiloto (Gemini)
GEMINI_API_KEY=

# --- Acceso y nube (Supabase) ---
# PÚBLICAS: las variables VITE_* quedan embebidas en el JavaScript del navegador.
# Usá solo la URL del proyecto y la clave pública (anon / publishable).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECRETAS: solo servidor (.env local y variables de entorno de Vercel). Nunca con prefijo VITE_.
# Clave service_role / secret: saltea RLS. La usa el servidor para validar sesiones, guardar auditorías
# y contar el límite de uso.
SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden usar la app, separados por comas. Vacía = no entra nadie.
ALLOWED_EMAILS=
# Opcional: URL del proyecto para el servidor. Si falta, se usa VITE_SUPABASE_URL.
# SUPABASE_URL=

# Solo desarrollo local: saltea el login. El servidor la ignora con NODE_ENV=production o en Vercel,
# y el navegador solo la mira en modo desarrollo (npm run dev). Van las dos juntas.
# AUTH_DISABLED=true
# VITE_AUTH_DISABLED=true
