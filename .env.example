# Solo nombres y valores de ejemplo. Copiá este archivo a .env y completá los reales; .env no se sube a git.

# Servidor local
PORT=3001
# Por defecto el servidor escucha solo en 127.0.0.1; HOST=0.0.0.0 lo expone a la red.
# HOST=127.0.0.1

# Mercado Libre (radar y "Por enlace"): ML_CLIENT_ID + ML_CLIENT_SECRET, o bien ML_ACCESS_TOKEN.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# ML_ACCESS_TOKEN=

# Copiloto (Gemini)
GEMINI_API_KEY=

# Supabase (opcional). Las variables VITE_* quedan embebidas en el JavaScript del navegador:
# usá solo la clave pública (anon / publishable), nunca una clave secreta o service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
